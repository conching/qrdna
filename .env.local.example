# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
NEXT_PUBLIC_APP_URL=https://qrdna.io
NEXT_PUBLIC_SHORT_DOMAIN=qrdna.io

# Billing kill switch
# Unset or "false"  -> every feature is free for all signed-in users; the Pro
#                      gates never fire and the upgrade CTAs are hidden.
# "true"            -> the Pro paywall is enforced again (Stripe must be configured).
NEXT_PUBLIC_BILLING_ENABLED=false

# Stripe (only needed when NEXT_PUBLIC_BILLING_ENABLED=true)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_PRO_ANNUAL_PRICE_ID=price_...
